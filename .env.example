# AI look-alike matching (server-side only — never use NEXT_PUBLIC_ for these)
# Required for the real AI visual-match path (/api/match). Without it, the app
# uses the clearly-marked local fallback (source: "fallback").
AI_API_KEY=

# Optional: vision-capable chat model (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# Optional: OpenAI-compatible base URL (default: https://api.openai.com/v1)
AI_BASE_URL=https://api.openai.com/v1
